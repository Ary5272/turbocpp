# Version control
.git
.gitignore
.github
.gitmodules
.gitattributes

# Build artifacts (re-built inside the image, don't pull stale ones in)
extras/standalone/build/
extras/standalone/build-*/
# Whole llama.cpp submodule — the Dockerfile installs llama-cpp-python from
# a prebuilt wheel instead of source-building, so the submodule isn't needed
# in the build context (and ignoring it shaves gigabytes off `docker build`).
llama.cpp/

# Standalone C++ extras — also not needed for the python image.
extras/

# Wheel build outputs and pyproject metadata clutter
dist/
build/

# Models / weights — never bake into images
*.gguf
*.safetensors
*.bin
*.tcpp
models/
hf_cache/

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# Editors
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db

# CMake leftovers (shouldn't be committed but be defensive)
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
